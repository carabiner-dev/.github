{
    id: drop-release
    meta: {
        description:
            '''
            # drop release verification

            Verifies the binaries published in the releases of
            https://github.com/carabiner-dev/drop through the SLSA provenance
            attestation shipped with every release (`drop-<tag>.provenance.json`).

            The provenance must be signed keyless (sigstore) by the release
            workflow of the drop repository running on GitHub Actions for a
            version tag. Only attestations from that signer are admitted, so a
            missing, unsigned or foreign-signed provenance fails verification.

            The admitted provenance is then checked with the SLSA policies from
            the carabiner policies repository: the artifact was built by the
            release workflow, with the GitHub Actions workflow build type, from
            the drop repository.
            '''
        version: 1
        frameworks: [
            { id: "SLSA", name: "Supply-Chain Levels for Software Artifacts" }
        ]
    }

    common: {
        // Only provenance signed by drop's release workflow on a version tag
        // is admitted for evaluation.
        identities: [
            {
                id: drop-release-workflow
                sigstore: {
                    issuerMatch: { exact: "https://token.actions.githubusercontent.com" }
                    identityMatch: { regex: "^https://github\\.com/carabiner-dev/drop/\\.github/workflows/release\\.yaml@refs/tags/v[0-9].*$" }
                }
            }
        ]

        context: {
            // The workflow that built the binaries (the provenance builder id
            // pins it to a commit, which the policy accepts as a suffix).
            builderId: { value: "https://github.com/carabiner-dev/drop/.github/workflows/release.yaml" }

            // Built with the GitHub Actions workflow build type
            buildType: { value: "https://actions.github.io/buildtypes/workflow/v1" }

            // Built from the drop repository
            buildPoint: { value: "git+ssh://github.com/carabiner-dev/drop" }
        }
    }

    policies: [
        {
            id: slsa-has-attestation
            source: {
                location: { uri: "git+https://github.com/carabiner-dev/policies@38b963e3ece486af6502a454df9609bbc95abcbd#slsa/has-attestation.json" }
            }
            meta: { controls: [ { framework: "SLSA", class: "BUILD", id: "LEVEL_1" } ] }
        }
        {
            id: slsa-builder-id
            source: {
                location: { uri: "git+https://github.com/carabiner-dev/policies@38b963e3ece486af6502a454df9609bbc95abcbd#slsa/slsa-builder-id.json" }
            }
            meta: { controls: [ { framework: "SLSA", class: "BUILD", id: "LEVEL_2" } ] }
        }
        {
            id: slsa-build-type
            source: {
                location: { uri: "git+https://github.com/carabiner-dev/policies@38b963e3ece486af6502a454df9609bbc95abcbd#slsa/slsa-build-type.json" }
            }
            meta: { controls: [ { framework: "SLSA", class: "BUILD", id: "LEVEL_2" } ] }
        }
        {
            id: slsa-build-point
            source: {
                location: { uri: "git+https://github.com/carabiner-dev/policies@38b963e3ece486af6502a454df9609bbc95abcbd#slsa/slsa-build-point.json" }
            }
            meta: { controls: [ { framework: "SLSA", class: "BUILD", id: "LEVEL_2" } ] }
        }
    ]
}
